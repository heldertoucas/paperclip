# Generated by Rulesync from .rulesync/permissions.jsonc (permission.bash)
# https://developers.openai.com/codex/rules

# *
prefix_rule(
    pattern = ["*"],
    decision = "allow",
    justification = "Generated from Rulesync permission.bash: *",
)

# git push --force*
prefix_rule(
    pattern = ["git", "push", "--force*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: git push --force*",
)

# git push * --force*
prefix_rule(
    pattern = ["git", "push", "*", "--force*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: git push * --force*",
)

# git push * -f*
prefix_rule(
    pattern = ["git", "push", "*", "-f*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: git push * -f*",
)

# git push * --delete*
prefix_rule(
    pattern = ["git", "push", "*", "--delete*"],
    decision = "forbidden",
    justification = "Generated from Rulesync permission.bash: git push * --delete*",
)

